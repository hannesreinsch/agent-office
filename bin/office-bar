#!/bin/zsh
# office-bar — the keys, on the status line, with the closed panes lit up.
#
#   set -g status-left "#(/path/to/office-bar '#{session_name}')"
#
# A pane's own border carries the chord that toggles it, which is no help at all
# once the pane is closed and the border went with it. So the bar keeps the
# whole set. Brightness carries one meaning and one only:
#
#   dim    the pane is open. You can see it, there is nothing to tell you
#   lit    the pane is closed. This is the one you cannot find
#
# "new" is separated off by a divider because it is an ACTION, not a state, and
# giving it the lit tone made it look like a fifth closed pane.
#
# tmux calls this every status-interval, so it does nothing but read tmux.
emulate -L zsh
s=${1:-}
[[ -n $s ]] || exit 0

OPEN=$'#[fg=#4e505a]'     # open: no news
SHUT=$'#[fg=#9a9ca6]'     # closed: the only thing worth your eye
ACTION=$'#[fg=#6a6c77]'   # neither: a thing you do
BAR=$'#[fg=#3a3c44]'
R=$'#[default]'

open=" $(tmux list-panes -t "=$s" -F '#{@office_kind}' 2>/dev/null | tr '\n' ' ')"

out="${ACTION}+ new ⌃⇧n${R}   ${BAR}│${R}  "
sep=""
for pair in "SHELL:shell:⌃⇧s" "EDITOR:editor:⌃⇧e" "CHAT:chat:⌃⇧c"; do
  kind=${pair%%:*}; rest=${pair#*:}; name=${rest%%:*}; key=${rest#*:}
  [[ $open == *" $kind "* ]] && tone=$OPEN || tone=$SHUT
  out+="${sep}${tone}${name} ${key}${R}"
  sep="${BAR} · ${R}"
done
print -rn -- "$out"
