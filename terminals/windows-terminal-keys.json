// Windows Terminal: you almost certainly do not need this.
//
// Windows Terminal already sends Ctrl+Shift+arrow as CSI 1;6 A-D, which is the
// only chord agent-office uses. Everything else is Ctrl-Space then a letter,
// which needs no terminal support at all.
//
// This file is here for the case where you have rebound those arrows to
// something else and want them back for tmux. Paste into your settings.json
// (Settings, then "open JSON file"), merging with any existing "actions" array.
{
  "actions": [
    { "command": { "action": "sendInput", "input": "\u001b[1;6A" }, "keys": "ctrl+shift+up" },
    { "command": { "action": "sendInput", "input": "\u001b[1;6B" }, "keys": "ctrl+shift+down" },
    { "command": { "action": "sendInput", "input": "\u001b[1;6C" }, "keys": "ctrl+shift+right" },
    { "command": { "action": "sendInput", "input": "\u001b[1;6D" }, "keys": "ctrl+shift+left" }
  ]
}
